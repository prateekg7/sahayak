[
  {
    "description": "Starts an interactive multiple-choice quiz on any academic topic. Use when the user asks to start a quiz or be tested, such as 'Alexa, quiz me on photosynthesis'. Do not use for answering questions in an active quiz; use quiz_answer instead.",
    "name": "quiz_start",
    "parameters": {
      "properties": {
        "difficulty": {
          "default": "medium",
          "title": "Difficulty",
          "type": "string"
        },
        "num_questions": {
          "default": 5,
          "title": "Num Questions",
          "type": "integer"
        },
        "request_id": {
          "default": "",
          "title": "Request Id",
          "type": "string"
        },
        "source": {
          "default": "topic",
          "title": "Source",
          "type": "string"
        },
        "topic": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Topic"
        }
      },
      "title": "quiz_startArguments",
      "type": "object"
    }
  }
]
