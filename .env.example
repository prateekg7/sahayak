# Copy to .env for local development. Do not commit real credentials.
APP_ENV=local
APP_NAME=Sahayak
PUBLIC_BASE_URL=http://localhost:8000
ENABLED_MODULES=template
DATABASE_URL=postgresql+asyncpg://sahayak:sahayak@postgres:5432/sahayak
REDIS_URL=redis://redis:6379/0
ALLOWED_ORIGINS=
MAX_TOOLS=15
MAX_TOOLS_PER_MODULE=4
SPOKEN_SUMMARY_MAX_CHARS=300
MAX_RESPONSE_BYTES=8192
REQUEST_TIMEOUT_SECONDS=0.45
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_GENERATION_PER_MINUTE=10
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
LLM_PRIMARY_PROVIDER=gemini
LLM_FALLBACK_PROVIDER=groq
LLM_PRIMARY_MODEL=
LLM_FALLBACK_MODEL=
GEMINI_API_KEY=
GROQ_API_KEY=
LLM_DAILY_BUDGET_REQUESTS=1000
QUIZ_TTL_MINUTES=120
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
